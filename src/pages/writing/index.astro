---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, href } from '../../lib/site';

const posts = await getPosts();
---
<Base title="Writing" description="Notes on data engineering and AI platforms.">
  <header class="page-head">
    <h1>Writing</h1>
    {posts.length === 0
      ? <p class="lede">No posts yet. Follow the <a href={href('/rss.xml')}>RSS feed</a> to hear about the first one.</p>
      : <p class="lede">Notes on data engineering and AI platforms. <a href={href('/rss.xml')}>RSS</a></p>}
  </header>

  {posts.length > 0 && (
    <ol class="link-list">
      {posts.map(({ id, data }) => (
        <li>
          <a class="link-row" href={href(`/writing/${id}/`)}>
            <time class="label" datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}{data.draft && ' · draft'}</time>
            <span class="value">{data.title}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  )}
</Base>
