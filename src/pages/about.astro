---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatMonth, getProfile, href } from '../lib/site';

const profile = await getProfile();
const experience = await getCollection('experience');
const education = await getCollection('education');
---
<Base title="About" description={`Career, education and languages. ${profile.lookingFor}`}>
  <header class="page-head">
    <h1>About</h1>
    {profile.about.map((paragraph) => <p class="lede">{paragraph}</p>)}
  </header>

  <section class="row" aria-labelledby="looking">
    <h2 id="looking" class="label">Looking for</h2>
    <div>
      <p>{profile.lookingFor}</p>
      <p><a href={href('/contact/')}>Get in touch</a> or read my <a href={href(`/${profile.resume}`)} type="application/pdf">résumé (PDF)</a>.</p>
    </div>
  </section>

  <section class="row" aria-labelledby="experience">
    <h2 id="experience" class="label">Experience</h2>
    <ol class="entries">
      {experience.map(({ data }) => (
        <li>
          <span class="meta">
            <time datetime={data.start}>{formatMonth(data.start)}</time> – {data.end ? <time datetime={data.end}>{formatMonth(data.end)}</time> : 'present'}
          </span>
          <span><strong>{data.title}</strong>, {data.url ? <a href={data.url}>{data.org}</a> : data.org}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="row" aria-labelledby="education">
    <h2 id="education" class="label">Education</h2>
    <ol class="entries">
      {education.map(({ data }) => (
        <li>
          <span class="meta"><time>{data.start}</time> – <time>{data.end}</time></span>
          <span><strong>{data.degree}</strong>, {data.url ? <a href={data.url}>{data.institution}</a> : data.institution}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="row" aria-labelledby="stack">
    <h2 id="stack" class="label">Stack</h2>
    <div>
      <ul class="tags">
        {profile.stack.primary.map((item) => <li>{item}</li>)}
      </ul>
      {profile.stack.secondary.length > 0 && <p class="meta">Also: {profile.stack.secondary.join(', ')}</p>}
    </div>
  </section>

  <section class="row" aria-labelledby="languages">
    <h2 id="languages" class="label">Languages</h2>
    <ul class="entries">
      {profile.languages.map(({ name, level }) => (
        <li><span class="meta">{level}</span><strong>{name}</strong></li>
      ))}
    </ul>
  </section>
</Base>
