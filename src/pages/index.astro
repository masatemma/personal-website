---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { absolute, getProfile, href } from '../lib/site';

const profile = await getProfile();
const experience = await getCollection('experience');
const education = await getCollection('education');
const current = experience.find(({ data }) => data.end === null)?.data;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.shortName,
  url: absolute('/', Astro.site),
  description: profile.tagline,
  jobTitle: profile.jobTitle,
  ...(current && { worksFor: { '@type': 'Organization', name: current.org, url: current.url } }),
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.location.city,
    addressCountry: profile.location.countryCode,
  },
  alumniOf: education.map(({ data }) => ({ '@type': 'CollegeOrUniversity', name: data.institution })),
  knowsAbout: [...profile.stack.primary, ...profile.stack.secondary],
  knowsLanguage: profile.languages.map(({ name, code }) => ({ '@type': 'Language', name, alternateName: code })),
  sameAs: [profile.links.linkedin, profile.links.github],
};
---
<Base description={`${profile.tagline} ${profile.summary}`} type="profile" jsonLd={person}>
  <h1>{profile.name}</h1>
  <p class="lede">{profile.tagline}</p>
  <p>{profile.summary}</p>

  <dl class="facts">
    <dt>Now</dt>
    <dd>{profile.now}</dd>
    <dt>Looking for</dt>
    <dd>{profile.lookingFor}</dd>
  </dl>

  <ul class="actions">
    <li><a href={href('/work/')}>Work</a></li>
    <li><a href={href(`/${profile.resume}`)} type="application/pdf">Résumé (PDF)</a></li>
    <li><a href={href('/contact/')}>Contact</a></li>
  </ul>
</Base>
